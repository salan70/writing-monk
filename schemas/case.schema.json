{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writing-monk.local/schemas/case.schema.json",
  "title": "WritingMonkCase",
  "type": "object",
  "required": ["id", "created_at", "status", "task"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "accepted", "rejected", "abandoned"]},
    "schema_version": {"type": "integer", "minimum": 1},
    "task": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "purpose": {"type": "string"},
        "topic": {"type": "string"}
      },
      "additionalProperties": true
    },
    "audience": {"type": "object", "additionalProperties": true},
    "agent": {
      "type": "object",
      "properties": {"tool": {"type": "string"}, "model": {"type": "string"}},
      "additionalProperties": true
    },
    "generation_context": {
      "type": "object",
      "properties": {
        "profile_version": {"type": "integer", "minimum": 0},
        "applied_preferences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
